{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia — Total (net) emissions, 2017–2023",
    "subtitle": "↓ 10.8% decrease from 2017–18 to 2022–23"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/chloechiaaaaa/DV2/refs/heads/main/GHG_Inventory_AusTotal.csv"
  },
  "width": 760,
  "height": 300,
  "transform": [
    { "filter": "datum.Scope == 'Australia'" },
    { "filter": "datum['IPCC emissions source and sink categories'] == 'Total (net emissions)'" },
    { "calculate": "toNumber(datum.Value)", "as": "E_Gg" },
    { "calculate": "toNumber(substring(datum.Attribute,0,4))", "as": "YearNum" }
  ],
  "layer": [
    {
      "mark": { "type": "rule", "stroke": "#efe7d1", "strokeWidth": 2.0 },
      "encoding": { "y": { "datum": 0 } }
    },
    {
      "mark": {
        "type": "line",
        "point": { "filled": true, "size": 60 },
        "strokeWidth": 2.5,
        "color": "#0f172a"
      },
      "encoding": {
        "x": {
          "field": "YearNum",
          "type": "quantitative",
          "axis": { "title": "Year", "format": "d", "tickMinStep": 1, "labelAngle": 0 }
        },
        "y": {
          "field": "E_Gg",
          "type": "quantitative",
          "title": "Emissions (Gg CO₂-e)",
          "scale": { "domain": [300000, 600000] },
          "axis": { "format": "," }
        },
        "tooltip": [
          { "field": "Attribute", "title": "Year" },
          { "field": "E_Gg", "title": "Net emissions (Gg CO₂-e)", "format": ",.0f" }
        ]
      }
    },
    {
      "transform": [
        { "window": [{ "op": "row_number", "as": "rn" }], "sort": [{ "field": "E_Gg", "order": "ascending" }] },
        { "filter": "datum.rn == 1" }
      ],
      "layer": [
        {
          "mark": { "type": "point", "filled": true, "size": 140, "color": "#0ea5e9", "stroke": "#0f172a", "strokeWidth": 1 },
          "encoding": {
            "x": { "field": "YearNum", "type": "quantitative" },
            "y": { "field": "E_Gg", "type": "quantitative" }
          }
        },
        {
          "mark": { "type": "text", "align": "left", "dx": -10, "dy": 20, "fontWeight": "bold", "color": "#0ea5e9" },
          "encoding": {
            "x": { "field": "YearNum", "type": "quantitative" },
            "y": { "field": "E_Gg", "type": "quantitative" },
            "text": { "value": "Lowest: COVID lockdowns cut transport & electricity demand" }
          }
        },
        {
          "mark": { "type": "text", "align": "left", "dx": 8, "dy": 8, "color": "#475569" },
          "encoding": {
            "x": { "field": "YearNum", "type": "quantitative" },
            "y": { "field": "E_Gg", "type": "quantitative" },
            "text": { "field": "E_Gg", "type": "quantitative", "format": ",.0f" }
          }
        }
      ]
    },
    {
      "transform": [
        { "window": [{ "op": "row_number", "as": "rn" }], "sort": [{ "field": "E_Gg", "order": "descending" }] },
        { "filter": "datum.rn == 1" }
      ],
      "layer": [
        {
          "mark": { "type": "point", "filled": true, "size": 140, "color": "#ef4444", "stroke": "#0f172a", "strokeWidth": 1 },
          "encoding": {
            "x": { "field": "YearNum", "type": "quantitative" },
            "y": { "field": "E_Gg", "type": "quantitative" }
          }
        },
        {
          "mark": { "type": "text", "align": "left", "dx": 8, "dy": -8, "fontWeight": "bold", "color": "#ef4444" },
          "encoding": {
            "x": { "field": "YearNum", "type": "quantitative" },
            "y": { "field": "E_Gg", "type": "quantitative" },
            "text": { "value": "Highest: Pre-COVID coal-heavy electricity & travel demand" }
          }
        },
        {
          "mark": { "type": "text", "align": "left", "dx": 8, "dy": 8, "color": "#475569" },
          "encoding": {
            "x": { "field": "YearNum", "type": "quantitative" },
            "y": { "field": "E_Gg", "type": "quantitative" },
            "text": { "field": "E_Gg", "type": "quantitative", "format": ",.0f" }
          }
        }
      ]
    }
  ],
  "config": {
    "background": "#f5f0e6",
    "view": { "stroke": null, "fill": "#ffffff" },
    "axis": {
      "grid": true,
      "gridColor": "#efe7d1",
      "tickColor": "#e5decf",
      "labelColor": "#0f172a",
      "titleColor": "#0f172a"
    },
    "title": {
      "color": "#0f172a",
      "fontWeight": 700,
      "subtitleColor": "#475569",
      "subtitleFontStyle": "italic",
      "subtitlePadding": 4
    },
    "numberFormat": ","
  }
}
