{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Australia — Sector emissions by year (stacked, signed)",
  "data": {
    "url": "https://raw.githubusercontent.com/chloechiaaaaa/DV2/refs/heads/main/GHG_Inventory_AusTotal.csv"
  },
  "width": 580,
  "height": 360,

  "transform": [
    { "filter": "datum.Scope == 'Australia'" },
    { "filter": "datum['IPCC emissions source and sink categories'] != 'Total (net emissions)'" },
    { "calculate": "toNumber(datum.Value)", "as": "E_Gg" },
    {
      "calculate": "indexof(datum['IPCC emissions source and sink categories'], 'Land-Use Change and Forestry') >= 0 ? '4. Land Use & Forestry (LULUCF)' : datum['IPCC emissions source and sink categories']",
      "as": "SectorShort"
    },
    { "aggregate": [{ "op": "sum", "field": "E_Gg", "as": "E_Sum" }], "groupby": ["Attribute", "SectorShort"] },
    { "joinaggregate": [{ "op": "sum", "field": "E_Sum", "as": "YearTotal" }], "groupby": ["Attribute"] },
    { "calculate": "datum.E_Sum / datum.YearTotal", "as": "Share" }
  ],

  "layer": [
    { "mark": { "type": "rule", "stroke": "#efe7d1", "strokeWidth": 1.5 }, "encoding": { "y": { "datum": 0 } } },
    {
      "mark": { "type": "bar", "cornerRadiusEnd": 2 },
      "encoding": {
        "x": {
          "field": "Attribute",
          "type": "ordinal",
          "title": null,
          "sort": ["2017-18","2018-19","2019-20","2020-21","2021-22","2022-23"],
          "axis": { "labelAngle": 0 }
        },
        "y": {
          "field": "E_Sum",
          "type": "quantitative",
          "title": "Emissions (Gg CO₂-e)",
          "stack": "zero",
          "axis": { "format": "," }
        },
        "color": {
          "field": "SectorShort",
          "type": "nominal",
          "title": "Sector",
          "scale": {
            "domain": [
              "1. Energy",
              "2.  Industrial Processes",
              "3.  Agriculture",
              "4. Land Use & Forestry (LULUCF)",
              "5.  Waste"
            ],
            "range": ["#e15759","#4e79a7","#59a14f","#9c755f","#f28e2b"]
          },
          "legend": { "orient": "right" }
        },
        "tooltip": [
          { "field": "SectorShort", "title": "Sector" },
          { "field": "Attribute", "title": "Year" },
          { "field": "E_Sum", "title": "Emissions (Gg CO₂-e)", "format": ",.0f" },
          { "field": "Share", "title": "Share of year", "format": ".1%" }
        ]
      }
    }
  ],

  "config": {
    "background": "#f5f0e6",
    "view": { "stroke": null, "fill": "#ffffff" },
    "axis": {
      "grid": true,
      "gridColor": "#efe7d1",
      "tickColor": "#e5decf",
      "labelColor": "#0f172a",
      "titleColor": "#0f172a"
    },
    "legend": { "labelColor": "#0f172a", "titleColor": "#0f172a", "symbolType": "circle" },
    "title": { "color": "#0f172a", "fontWeight": 700 },
    "numberFormat": ","
  }
}
