{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GHG Total (net) Emissions by State — 2017–2022",
    "subtitle": "Note: Tasmania and Australian Capital Territory dip below zero — net absorbers",
    "subtitleColor": "#475569",
    "subtitleFontSize": 12,
    "subtitlePadding": 6
  },
  "data": {
    "url": "https://raw.githubusercontent.com/chloechiaaaaa/DV2/refs/heads/main/GHG_Inventory_State.csv"
  },
  "transform": [
    { "filter": "indexof(datum.Category, 'Total (net emissions)') >= 0" },
    { "calculate": "toNumber(substring(datum.Year,0,4))", "as": "YearNum" },
    { "filter": "datum.YearNum >= 2017 && datum.YearNum <= 2022" },
    { "calculate": "toNumber(replace(datum['Emissions (Gg CO₂-e)'] + '', ',', ''))", "as": "E_Gg" },
    {
      "calculate": "datum.State == 'NSW' ? 'New South Wales' : datum.State == 'VIC' ? 'Victoria' : datum.State == 'QLD' ? 'Queensland' : datum.State == 'SA' ? 'South Australia' : datum.State == 'WA' ? 'Western Australia' : datum.State == 'TAS' ? 'Tasmania' : datum.State == 'NT' ? 'Northern Territory' : datum.State == 'ACT' ? 'Australian Capital Territory' : datum.State",
      "as": "StateFull"
    },
    { "filter": "datum.State != 'AUS'" }
  ],
  "width": 920,
  "height": 320,
  "layer": [
    {
      "mark": { "type": "line", "point": true, "strokeWidth": 2 },
      "encoding": {
        "x": {
          "field": "YearNum",
          "type": "quantitative",
          "axis": { "title": "Year", "format": "d", "tickMinStep": 1, "labelAngle": 0 }
        },
        "y": {
          "field": "E_Gg",
          "type": "quantitative",
          "title": "Emissions (Gg CO₂-e)",
          "axis": { "format": "," },
          "scale": { "domain": [-10000, 180000], "clamp": true }
        },
        "color": {
          "field": "StateFull",
          "type": "nominal",
          "sort": [
            "New South Wales",
            "Victoria",
            "Queensland",
            "South Australia",
            "Western Australia",
            "Tasmania",
            "Northern Territory",
            "Australian Capital Territory"
          ],
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "South Australia",
              "Western Australia",
              "Tasmania",
              "Northern Territory",
              "Australian Capital Territory"
            ],
            "range": ["#4e79a7","#e15759","#f28e2b","#76b7b2","#59a14f","#9c755f","#edc948","#b07aa1"]
          },
          "legend": { "orient": "right", "title": "State" }
        },
        "tooltip": [
          { "field": "StateFull", "title": "State" },
          { "field": "Year", "title": "Year (FY)" },
          { "field": "E_Gg", "title": "Emissions (Gg CO₂-e)", "format": "," }
        ]
      }
    },
    {
      "mark": { "type": "rule", "strokeDash": [6,4], "color": "red" },
      "encoding": { "x": { "datum": 2020 } }
    }
  ],
  "config": {
    "background": "#f5f0e6",
    "view": { "stroke": null, "fill": "white" },
    "axis": {
      "grid": true,
      "gridColor": "#dbe4f0",
      "tickColor": "#c7d4e6",
      "labelColor": "#0f172a",
      "titleColor": "#0f172a",
      "labelFont": "system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "titleFont": "system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#0f172a",
      "titleColor": "#0f172a",
      "symbolType": "circle"
    }
  }
}
