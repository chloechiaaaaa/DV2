{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Emission Intensity by State (2017–2022)",
  "data": {
    "url": "https://raw.githubusercontent.com/chloechiaaaaa/DV2/refs/heads/main/Emission_Intensity.csv"
  },

  "params": [
    {
      "name": "stateInput",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "State: ",
        "options": ["All","NSW","VIC","QLD","SA","WA","TAS","NT","ACT"]
      }
    }
  ],

  "transform": [
    { "calculate": "toNumber(substring(datum.Year, 0, 4))", "as": "YearStart" },
    { "filter": "datum.YearStart >= 2017 && datum.YearStart <= 2022" },
    { "filter": "stateInput == 'All' || datum.Attribute == stateInput" }
  ],

  "mark": "rect",

  "encoding": {
    "x": { "field": "Year", "type": "ordinal", "title": "Year" },
    "y": {
      "field": "Attribute",
      "type": "nominal",
      "title": null,
      "sort": ["NSW","VIC","QLD","SA","WA","TAS","NT","ACT"]
    },
    "color": {
      "field": "Value",
      "type": "quantitative",
      "title": "Emission Intensity (t CO₂-e per capita)",
      "legend": { "titleLimit": 0 },
      "scale": { "scheme": "blueorange" }
    },
    "tooltip": [
      { "field": "Attribute", "title": "State" },
      { "field": "Year" },
      { "field": "Value", "title": "Intensity", "format": ".2f" }
    ]
  },

  "config": {
    "view": { "stroke": "transparent" },
    "axis": { "grid": false },
    "background": "#FFF8E7"
  },
  "width": 550,
  "height": 300
}
